# ── Gateway (Elysia control plane + Mastra agent runtime, in-process) ────────
# Port the Elysia server listens on (Mastra is mounted at /mastra on the same port).
PORT=3000

# ── Mastra agent runtime ───────────────────────────────────────────────────
# Mastra "magic string" model id (provider/model-name). API keys for the chosen
# provider are read from env automatically, e.g. OPENAI_API_KEY for openai/*.
MASTRA_MODEL=openai/gpt-4o-mini

# Required when the default model is an openai/* variant.
OPENAI_API_KEY=

# ── Database (Drizzle ORM + Postgres; Drizzle owns the schema) ────────────────
# Works with both local Postgres and Supabase (cloud). The DB client and
# drizzle-kit auto-detect SSL based on the URL (see packages/db/src/client.ts),
# so no extra ssl params are needed for either option.
#
# Option A — local Postgres:
#   docker run -d --name hyros-pg -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=hyros -p 5432:5432 postgres:16
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hyros
#
# Option B — Supabase (recommended for cloud):
#   Supabase dashboard → Project Settings → Database → Connection string →
#   "Pooler" (Session mode, port 5432). Use the POOLER URL, NOT the direct
#   connection — the direct endpoint (db.<ref>.supabase.co) is IPv6-only on the
#   free tier and won't resolve on IPv4-only networks. The pooler provides IPv4.
#   Username format: postgres.<PROJECT-REF>
#   DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-<SHARD>-<REGION>.pooler.supabase.com:5432/postgres
#
# Then: bun --filter @hyros-ai/db run db:push   (sync schema to the DB)
#   (run from the repo root so the root .env is loaded; see packages/db/README
#   or run: cd packages/db && set -a && source ../../.env && set +a && bunx drizzle-kit push --force)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hyros

# ── Supabase (auth + SSO; Supabase owns auth.*, Drizzle owns the app schema) ─
# One-time dashboard setup: see docs/auth-supabase-setup.md (create project,
# enable Google OAuth, set redirect URLs). Per agent-os-architecture.md §4.
#
# Server-only (gateway) — NEVER ship these to the desktop client. The gateway
# uses the service-role key to verify Supabase JWTs and (later) admin calls.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
#
# NOTE: the desktop (Tauri/Vite) client uses the anon key via VITE_-prefixed
# vars in apps/desktop/.env.example — the anon key is public-safe (RLS-protected).
