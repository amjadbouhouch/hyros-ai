{
  "name": "@hyros-ai/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env run --watch src/server.ts",
    "start": "bun --env-file=../../.env run src/server.ts",
    "build": "bun build src/cli.ts --compile --outfile dist/hyros-ai-gateway",
    "test": "bun test",
    "typecheck": "tsc --build",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@hyros-ai/db": "workspace:*",
    "@hyros-ai/domain": "workspace:*",
    "@mastra/core": "^1.55.0",
    "@mastra/evals": "^1.6.0",
    "@mastra/hono": "^1.5.12",
    "@mastra/libsql": "^1.18.0",
    "@mastra/loggers": "^1.2.0",
    "@mastra/memory": "^1.24.0",
    "@mastra/observability": "^1.16.3",
    "@supabase/supabase-js": "^2.112.0",
    "elysia": "^1.3.0",
    "hono": "^4.12.34",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  }
}