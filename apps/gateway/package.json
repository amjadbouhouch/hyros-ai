{
  "name": "@hyros-ai/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/index.ts"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun --env-file=../../.env run --watch src/server.ts",
    "start": "bun --env-file=../../.env run src/server.ts",
    "build": "bun build src/cli.ts --compile --outfile dist/hyros-ai-gateway",
    "test": "bun test --env-file=../../.env src",
    "typecheck": "tsc --build",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@dicebear/core": "^10.5.0",
    "@dicebear/styles": "^10.5.0",
    "@elysiajs/cors": "^1.4.2",
    "@hyros-ai/db": "workspace:*",
    "@hyros-ai/domain": "workspace:*",
    "@hyros-ai/utils": "workspace:*",
    "@mastra/core": "^1.59.0",
    "@mastra/evals": "^1.7.0",
    "@mastra/hono": "^1.6.1",
    "@mastra/langfuse": "^1.4.8",
    "@mastra/libsql": "^1.20.0",
    "@mastra/loggers": "^1.2.0",
    "@mastra/memory": "^1.26.2",
    "@mastra/observability": "^1.17.0",
    "@mastra/pg": "^1.20.0",
    "@supabase/supabase-js": "^2.112.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.3.0",
    "hono": "^4.12.34",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  }
}
