{
  "name": "@hyros-ai/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "hyros-ai": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "start": "bun run src/cli.ts",
    "build": "bun build ./src/cli.ts --compile --outfile dist/hyros-ai",
    "typecheck": "tsc --build",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@hyros-ai/api-client": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  }
}