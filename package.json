{
  "name": "hyros-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*",
    "sandbox-service"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:gateway": "turbo dev --filter=@hyros-ai/gateway",
    "dev:desktop": "turbo dev --filter=@hyros-ai/desktop",
    "dev:tauri": "cd apps/desktop && bun run tauri:dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "bun@1.3.14"
}